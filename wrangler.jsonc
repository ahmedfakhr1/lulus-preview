{
  "$schema": "node_modules/wrangler/config-schema.json",
  // the Cloudflare Worker's name (its address becomes lulus.<account>.workers.dev)
  "name": "lulus",
  "compatibility_date": "2026-10-12",
  // only /api/hit runs code (visit and tap counting); everything else is served from dist/
  "main": "src/worker.js",
  // runs before every deploy: copies the site into dist/ and fills in config/site.config.js
  "build": { "command": "node tools/build.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // visits and taps, free on the Workers free plan (src/worker.js writes, tools/apps-script/lulus-sheet.gs reads)
  "analytics_engine_datasets": [{ "binding": "HITS", "dataset": "lulus_hits" }]
}
